# Rust build output.
/target

# Default `lx build --output` directory and the release workflow's
# per-format dogfood output dirs (`dist-deb/`, `dist-rpm/`, `dist-arch/`).
/dist
/dist-*/

# Per-workspace build output (mirrors `/target` for helper crates).
/utils/*/target

# Generated by `lx build` / the GitHub Action; never part of the source tree.
# `failed-build-logs/` and `.telemetry/` are created relative to the working
# directory (build.rs / telemetry.rs), and `__out/` is the packager staging
# output sibling (plugins/mod.rs) — unanchored so they are ignored wherever
# the tool runs. `build-summary.json` is written into the output directory.
failed-build-logs/
.telemetry/
__out/
build-summary.json
